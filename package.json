{
  "name": "simple-http-request-builder",
  "version": "2.2.1",
  "description": "A simple HTTP request interface written in TypeScript",
  "author": "Aurélien Manteaux <amanteaux@coreoz.com> (https://coreoz.com)",
  "homepage": "https://github.com/coreoz/simple-http-request-builder",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "http",
    "request",
    "rest",
    "api"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typescript": "tsc --noEmit",
    "eslint": "eslint src",
    "prepare-release": "yarn typescript && yarn eslint && yarn test && yarn build",
    "release": "release-it"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "yarn prepare-release"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "release-it": "^17.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Coreoz/simple-http-request-builder"
  },
  "bugs": {
    "url": "https://github.com/Coreoz/simple-http-request-builder/issues"
  },
  "packageManager": "yarn@4.18.0"
}
